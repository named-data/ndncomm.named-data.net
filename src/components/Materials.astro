---
import Icon from './Icon.astro';
import { url } from '../lib/archive';

interface Props {
  video?: string;
  slides?: string;
  more?: { label: string; url: string }[];
  moreSlides?: { label: string; url: string }[];
}
const { video, slides, more = [], moreSlides = [] } = Astro.props;
const href = (u: string) => (/^https?:/.test(u) ? u : url(u));
const kind = (u: string) => (/\.pptx?$/i.test(u) ? 'PPT' : 'PDF');
const slidesHref = slides && href(slides);
const slidesKind = slides && kind(slides);
---

{
  (video || slides || more.length > 0 || moreSlides.length > 0) && (
    <div class="materials">
      {video && (
        <a class="material material-video" href={video} target="_blank" rel="noopener">
          <Icon name="play" size={13} />
          Video
        </a>
      )}
      {more.map((v) => (
        <a class="material material-video" href={v.url} target="_blank" rel="noopener">
          <Icon name="play" size={13} />
          {v.label}
        </a>
      ))}
      {slidesHref && (
        <a class="material" href={slidesHref} target="_blank" rel="noopener">
          <Icon name="file" size={13} />
          Slides <span class="muted">{slidesKind}</span>
        </a>
      )}
      {moreSlides.map((d) => (
        <a class="material" href={href(d.url)} target="_blank" rel="noopener">
          <Icon name="file" size={13} />
          {d.label} <span class="muted">{kind(d.url)}</span>
        </a>
      ))}
    </div>
  )
}

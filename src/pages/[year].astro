---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Program from '../components/Program.astro';
import { url, documents, kalturaInfo, formatDuration, pageHtml, orgLogo, orgUrl, personUrl } from '../lib/archive';
import { allMeetings, dateRange, FORMAT_LABEL, isUpcoming, programFor, type Meeting } from '../lib/meetings';

export async function getStaticPaths() {
  return (await allMeetings()).map((meeting) => ({ params: { year: meeting.id }, props: { meeting } }));
}

const { meeting } = Astro.props as { meeting: Meeting };
const m = meeting.data;
const year = meeting.id;
const upcoming = isUpcoming(meeting);
const program = await programFor(year);
const docs = documents(year);
const kaltura = kalturaInfo(year);
const original = m.original_page ? pageHtml(year, m.original_page) : '';
// External links open in a new tab, so visitors don't leave the site.
const ext = (href?: string) => (href ? { target: '_blank', rel: 'noopener' } : {});
// Only recordings already on YouTube are shown; ones still to be uploaded stay out of the page.
const videos = m.videos.filter((v) => v.youtube);
const organizers = m.organizers.map((o) => ({
  ...o,
  logo: orgLogo(o.affiliation),
  orgHref: orgUrl(o.affiliation),
  href: personUrl(o.name),
}));
const place = [m.venue, m.city].filter(Boolean).join(', ');
const initials = (n: string) =>
  n
    .split(/\s+/)
    .filter((w) => /^\p{Lu}/u.test(w))
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

<Base title={m.title} description={`${m.title}, ${dateRange(m.start, m.end)}: program, abstracts and recordings.`} overlayHeader>
  <section class="hero meeting-hero">
    <div class="wrap">
      <a class="crumbs" href={url()}><Icon name="arrow" size={14} />All meetings</a>
      <div>
        <span class="eyebrow"><span class="dot"></span>NDNComm {year}</span>
        <span class:list={['status-pill', { upcoming }]}>{upcoming ? 'Upcoming' : FORMAT_LABEL[m.format]}</span>
      </div>
      <h1>{m.title}</h1>
      <div class="hero-facts">
        <span class="fact"><Icon name="calendar" />{dateRange(m.start, m.end)}</span>
        <span class="fact"><Icon name="pin" />{place || 'Online'}{place && m.format === 'hybrid' ? ' · and online' : ''}</span>
        {m.host && <span class="fact"><Icon name="users" />Hosted by {m.host.short}</span>}
      </div>
      {m.summary && <p class="lede" style="margin-top: 18px">{m.summary}</p>}
      <div class="btn-row">
        {program && <a class="btn btn-primary" href="#program">View program <Icon name="arrow" size={16} /></a>}
        {videos.length > 0 && <a class="btn btn-ghost" href="#recordings"><Icon name="play" size={15} />Recordings</a>}
        {m.links?.registration && <a class="btn btn-primary" href={m.links.registration}>Register</a>}
        {m.links?.call_for_submissions && <a class="btn btn-ghost" href={m.links.call_for_submissions}>Call for submissions</a>}
      </div>
    </div>
  </section>

  <div class="wrap">
    {
      m.original_page && (
        <aside class="provenance">
          <Icon name="archive" size={20} />
          <p>
            {m.host && <strong>Organized and hosted by the {m.host.name}. </strong>}
            This page preserves the program, abstracts and recordings from the original event page at{' '}
            <a href={m.original_page}>{m.original_page.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>.
          </p>
        </aside>
      )
    }

    <div class="page-grid">
      <div>
        {
          (videos.length > 0 || m.video_note) && !upcoming && (
            <section class="block" id="recordings">
              <h2>Recordings</h2>
              {videos.length > 0 && <p class="sub">Full-length recordings of the meeting.</p>}
              <div class="videos">
                {videos.map((v) => {
                  const k = v.kaltura ? kaltura[v.kaltura] : undefined;
                  return (
                    <figure class="video-card" style="margin: 0">
                      {v.youtube ? (
                        <div class="player">
                          <iframe
                            src={`https://www.youtube-nocookie.com/embed/${v.youtube}`}
                            title={v.label}
                            loading="lazy"
                            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                          />
                        </div>
                      ) : (
                        <div class="player player-pending">
                          <span class="play-ring"><Icon name="play" size={24} /></span>
                          <span class="pending-label">Coming soon to YouTube</span>
                          {k && <span class="duration">{formatDuration(k.duration_sec)}</span>}
                        </div>
                      )}
                      <figcaption class="video-meta">
                        <b>{v.label.split(' — ')[0]}</b>
                        <span>{v.label.split(' — ')[1]}</span>
                      </figcaption>
                    </figure>
                  );
                })}
              </div>
              {m.video_note && (
                <p class="note note-info">
                  <Icon name="play" />
                  <span>{m.video_note}</span>
                </p>
              )}
            </section>
          )
        }

        {
          program && (
            <section class="block" id="program">
              <h2>Program</h2>
              <p class="sub">Select a talk to read its abstract.</p>
              <Program program={program} />
            </section>
          )
        }

        {
          original && (
            <section class="block">
              <details class="original">
                <summary>
                  <Icon name="file" />
                  Original event page text, as published by {m.host?.short ?? 'the host'}
                  <span class="toggle">+</span>
                </summary>
                <div class="prose" set:html={original} />
              </details>
            </section>
          )
        }
      </div>

      <aside>
        {
          m.organizers.length > 0 && (
            <div class="side-card">
              <h3>Organizers</h3>
              <ul class="people">
                {organizers.map((o) => (
                  <li>
                    {o.logo ? (
                      <a href={o.orgHref} {...ext(o.orgHref)} class:list={['avatar', 'avatar-logo', { wide: o.logo.wide }]} title={o.affiliation}>
                        <img src={o.logo.href} alt={o.affiliation} loading="lazy" />
                      </a>
                    ) : (
                      <span class="avatar">{initials(o.name)}</span>
                    )}
                    <div>
                      <a href={o.href} {...ext(o.href)} class="person-name">{o.name}</a>
                      <a href={o.orgHref} {...ext(o.orgHref)} class="person-org">{o.affiliation}</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          (docs.length > 0 || m.links?.slides) && (
            <div class="side-card">
              <h3>Documents</h3>
              <ul class="doc-list">
                {docs.map((d) => (
                  <li>
                    <a class="doc-link" href={d.href}>
                      <Icon name="file" />
                      {d.kind}
                      <small>PDF</small>
                    </a>
                  </li>
                ))}
                {m.links?.slides && (
                  <li>
                    <a class="doc-link" href={m.links.slides}>
                      <Icon name="external" />
                      Presentation slides
                      <small>Drive</small>
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Base>
